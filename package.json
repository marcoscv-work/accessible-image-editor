		"babel-eslint": "^10.1.0",
		"eslint": "^8.57.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jest-axe": "^11.0.0",
		"jsdom": "^30.0.1",
